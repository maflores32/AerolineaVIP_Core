@model IEnumerable<AerolineaVIP_Core.Models.Aeropuerto>

@{
    ViewData["Title"] = "Aeropuertos";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <span class="badge bg-dark mb-1">CATÁLOGO DE OPERACIÓN</span>
        <h2 class="mb-1">Aeropuertos</h2>
        <p class="text-muted mb-0">Administre aeropuertos y sus códigos IATA para configurar rutas.</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">← Inicio</a>
        <a asp-action="Create" class="btn btn-vip">Crear aeropuerto</a>
    </div>
</div>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success" role="status">@TempData["Mensaje"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-warning" role="alert">@TempData["Error"]</div>
}

<div class="card shadow-sm">
    <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <h3 class="h5 mb-0">Aeropuertos registrados</h3>
        <span class="badge bg-secondary">@Model.Count()</span>
    </div>
    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <div class="text-center text-muted p-4">
                <p class="mb-2">Todavía no hay aeropuertos configurados.</p>
                <a asp-action="Create" class="btn btn-outline-primary">Crear el primer aeropuerto</a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th scope="col">Código IATA</th>
                            <th scope="col">Nombre</th>
                            <th scope="col">Localidad</th>
                            <th scope="col">Estado</th>
                            <th scope="col" class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td><span class="badge bg-dark">@item.codigoIATA</span></td>
                                <td>@item.nombre</td>
                                <td>@item.localidad</td>
                                <td><span class="badge @item.ClaseEstado">@item.EstadoTexto</span></td>
                                <td class="text-end text-nowrap">
                                    <a asp-action="Details" asp-route-id="@item._id" class="btn btn-sm btn-outline-info">Detalles</a>
                                    <a asp-action="Edit" asp-route-id="@item._id" class="btn btn-sm btn-outline-primary">Editar</a>
                                    <a asp-action="Delete" asp-route-id="@item._id" class="btn btn-sm btn-outline-danger">Eliminar</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
