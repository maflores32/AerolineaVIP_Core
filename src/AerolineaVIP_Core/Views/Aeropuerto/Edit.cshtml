@model AerolineaVIP_Core.Models.Aeropuerto

@{
    ViewData["Title"] = "Editar aeropuerto";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <span class="badge bg-dark mb-1">CATÁLOGO DE OPERACIÓN</span>
        <h2 class="mb-1">Editar aeropuerto</h2>
        <p class="text-muted mb-0">Actualice los datos y la disponibilidad del aeropuerto.</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">← Volver a aeropuertos</a>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <form asp-action="Edit" asp-route-id="@Model._id" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            <input type="hidden" asp-for="_id" />
            <div class="row g-3">
                <div class="col-md-4">
                    <label asp-for="codigoIATA" class="form-label fw-semibold"></label>
                    <input asp-for="codigoIATA" class="form-control" maxlength="3" autocomplete="off" />
                    <span asp-validation-for="codigoIATA" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="nombre" class="form-label fw-semibold"></label>
                    <input asp-for="nombre" class="form-control" maxlength="120" />
                    <span asp-validation-for="nombre" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="localidad" class="form-label fw-semibold"></label>
                    <input asp-for="localidad" class="form-control" maxlength="100" />
                    <span asp-validation-for="localidad" class="text-danger"></span>
                </div>
                <div class="col-12">
                    <div class="form-check">
                        <input asp-for="activo" class="form-check-input" />
                        <label asp-for="activo" class="form-check-label"></label>
                    </div>
                </div>
            </div>
            <div class="d-flex flex-wrap gap-2 mt-4">
                <button type="submit" class="btn btn-vip">Guardar cambios</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
