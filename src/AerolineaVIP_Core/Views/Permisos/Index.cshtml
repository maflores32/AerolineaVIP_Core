@model Microsoft.AspNetCore.Identity.IdentityRole

@{
    ViewData["Title"] = "Configurar Permisos";
    var permisosActivos = ViewBag.PermisosActivos as List<string> ?? new List<string>();
    
    // Módulos personalizados de la Aerolínea VIP
    var modulos = new[]
    {
        new { Clave = "Vuelos", Nombre = "Vuelos" },
        new { Clave = "Reservas", Nombre = "Reservas" },
        new { Clave = "Compras", Nombre = "Compras/Pagos" },
        new { Clave = "CheckIn", Nombre = "Check-In" },
        new { Clave = "Reportes", Nombre = "Reportes" }
    };
    var acciones = new[] { "Ver", "Crear", "Actualizar", "Eliminar" };
}

<div class="container mt-4">
    <div class="text-center mb-4">
        <h2 class="fw-bold">Gestión de Permisos</h2>
        <p class="text-muted">Configura los accesos de la aerolínea</p>
    </div>

    <form asp-action="Guardar" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="rolId" value="@Model.Id" />

        <div class="card shadow-sm border-0 rounded-4 p-4">
            <div class="alert alert-light border rounded-3 mb-4 fw-bold text-secondary text-center">
                Rol: @Model.Name
            </div>

            <table class="table align-middle text-center">
                <thead class="table-light">
                    <tr>
                        <th class="text-start ps-3">Módulo</th>
                        <th>Ver</th>
                        <th>Crear</th>
                        <th>Actualizar</th>
                        <th>Eliminar</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var mod in modulos)
                    {
                        <tr>
                            <td class="text-start ps-3 fw-semibold">@mod.Nombre</td>
                            @foreach (var accion in acciones)
                            {
                                string valorPermiso = $"{mod.Clave}.{accion}";
                                bool estaActivo = permisosActivos.Contains(valorPermiso);
                                <td>
                                    <div class="form-check form-switch d-inline-block">
                                        <input class="form-check-input" type="checkbox" role="switch"
                                               name="permisosSeleccionados" value="@valorPermiso"
                                        @(estaActivo ? "checked" : "") />
                                    </div>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>

            <div class="d-flex justify-content-between mt-4">
                <a asp-action="Listar" class="btn btn-outline-secondary rounded-pill px-4">Volver</a>
                <button type="submit" class="btn btn-success rounded-pill px-4">Guardar Cambios</button>
            </div>
        </div>
    </form>
</div>