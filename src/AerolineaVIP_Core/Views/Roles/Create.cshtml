@{
    ViewData["Title"] = "Crear Rol";
}

<div class="container mt-4 d-flex justify-content-center">
    <div class="card shadow-sm rounded-4 p-4" style="max-width: 500px; width: 100%;">
        <h3 class="fw-bold text-center mb-4">Crear Nuevo Rol</h3>
        
        <!-- Formulario que envía el nombre del rol al método POST del controlador -->
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <!-- Resumen de errores de validación -->
            <div asp-validation-summary="All" class="text-danger mb-3"></div>
            
            <div class="mb-3">
                <label class="form-label fw-semibold">Nombre del Rol</label>
                <input type="text" name="roleName" class="form-control" required placeholder="Ej: ROL-VIP, ROL-AUDITOR" />
            </div>
            
            <div class="d-flex justify-content-between mt-4">
                <a asp-action="Index" class="btn btn-secondary rounded-pill px-4">Volver</a>
                <button type="submit" class="btn btn-success rounded-pill px-4">Guardar</button>
            </div>
        </form>
    </div>
</div>