@model IEnumerable<Microsoft.AspNetCore.Identity.IdentityUser>

@{
    ViewData["Title"] = "Gestión de Usuarios y Roles";
    // Se recupera el diccionario que envió el controlador con los roles de cada usuario
    var rolesPorUsuario = ViewBag.RolesPorUsuario as Dictionary<string, IList<string>> ?? new Dictionary<string, IList<string>>();
}

<div class="container mt-4">
    <h2 class="mb-4 fw-bold">Gestión de Usuarios y Roles</h2>

    <table class="table align-middle">
        <thead style="background-color: #212529; color: white;">
            <tr>
                <th scope="col" style="padding: 12px 16px;">Usuario</th>
                <th scope="col" style="padding: 12px 16px;">Email</th>
                <th scope="col" style="padding: 12px 16px;">Roles Asignados</th>
                <th scope="col" style="padding: 12px 16px;">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model)
            {
                // Se buscan los roles del usuario en el diccionario
                var roles = rolesPorUsuario.ContainsKey(user.Id) ? rolesPorUsuario[user.Id] : new List<string>();
                <tr style="border-bottom: 1px solid #dee2e6;">
                    <td style="padding: 12px 16px;">@user.UserName</td>
                    <td style="padding: 12px 16px;">@user.Email</td>
                    <td style="padding: 12px 16px;">
                        @if (roles.Any())
                        {
                            foreach (var rol in roles)
                            {
                                <span class="badge bg-primary me-1" style="font-weight: 500; font-size: 0.85rem; padding: 5px 10px; border-radius: 4px;">@rol</span>
                            }
                        }
                        else
                        {
                            <span class="text-secondary" style="font-size: 0.95rem;">Sin roles</span>
                        }
                    </td>
                    <td style="padding: 12px 16px;">
                        <a asp-action="EditarRoles" asp-route-usuarioId="@user.Id" class="btn btn-warning btn-sm" style="background-color: #f59e0b; border-color: #f59e0b; color: #000; font-weight: 500; border-radius: 4px; padding: 4px 14px;">Editar Roles</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>